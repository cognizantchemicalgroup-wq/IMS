# CCPL ERP Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.

# Firebase Configuration
FIREBASE_PROJECT_ID=ccpl-ims
FIREBASE_API_KEY=AIzaSyASaR4XRhIgrSMAgvHGaLpxfCKMKvDLLro
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=cognizantchemical.group@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=cognizantchemical.group@gmail.com
SMTP_FROM_NAME=CCPL IMS

# OTP Policy Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SECRET_KEY=change-this-to-a-random-64-character-hex-string

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
