# CCPL ERP - Apache / Hostinger Production Configuration
Options -Indexes +FollowSymLinks
DirectoryIndex index.html
ServerSignature Off

# Pass the "Authorization: Bearer <token>" header through to PHP (needed by api/file.php and api/storage-admin.php)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Security headers + keep every page out of search engines
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always unset X-Powered-By
    # Pages and API answers must not be cached by shared proxies
    <FilesMatch "\.(html|php)$">
        Header always set Cache-Control "private, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Block hidden files, environment / credential files, data and source files that are not part of the website
<FilesMatch "(^\.|^composer\.(json|lock|phar)$|service-account.*\.json$|\.(json|rules|mjs|md|log|lock|bak|sql|zip|sh|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Routing & URL rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (logins and documents must never travel in clear text)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Block server-side code, tooling and test folders
    RewriteRule ^(admin|tests|vendor|node_modules|backups)(/|$) - [F,L]

    # If the file or directory exists physically, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Internally map clean URL to .html without redirecting
    RewriteCond %{REQUEST_FILENAME}.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
