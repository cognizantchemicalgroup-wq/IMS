rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function validDocumentUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)|image/(jpeg|png)');
    }

    match /CCPL-IMS/invoices/{inwardId}/{fileName} {
      allow read: if true;
      allow create, update: if validDocumentUpload();
      allow delete: if true;
    }
    match /CCPL-IMS/supplier-coa/{inwardId}/{fileName} {
      allow read: if true;
      allow create, update: if validDocumentUpload();
      allow delete: if true;
    }
    match /CCPL-IMS/purchase-order/{inwardId}/{fileName} {
      allow read: if true;
      allow create, update: if validDocumentUpload();
      allow delete: if true;
    }
    match /CCPL-IMS/kanta-slips/{inwardId}/{fileName} {
      allow read: if true;
      allow create, update: if validDocumentUpload();
      allow delete: if true;
    }
  }
}
