rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeUser() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function validDocument() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)|image/(jpeg|png)');
    }
    match /CCPL-IMS/{folder}/{docId}/{fileName} {
      allow read: if activeUser();
      allow create: if activeUser() && validDocument();
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
