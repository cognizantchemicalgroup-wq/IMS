rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if false;
    }

    match /inward/{document=**} {
      allow read, create, update, delete: if true;
    }
    match /kanta/{document=**} {
      allow read, create, update, delete: if true;
    }
    match /grn/{document=**} {
      allow read, create, update, delete: if true;
    }
    match /stock/{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /stockLedger/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /packaging_stock/{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /packaging_receipts/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /packaging_configurations/{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /packaging_transactions/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /outward/{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
